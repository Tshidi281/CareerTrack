<div class="page">
  <div class="container-narrow">
    <div class="card">
      <h1>Log in to CareerTrack</h1>
      <%- include('../partials/flash') %>
      <% if (errors && errors.length) { %>
        <div class="alert alert-error"><ul style="margin:0; padding-left:18px;"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <% } %>
      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log In</button>
      </form>
      <p style="text-align:center; margin-top:12px; font-size:.88rem;"><a href="/forgot-password">Forgot password?</a></p>
      <p style="text-align:center; margin-top:16px; font-size:.88rem;">Don't have an account? <a href="/register">Sign up</a></p>

      <div class="divider"></div>
      <p style="font-size:.8rem; color:var(--slate-500);"><strong>Demo accounts</strong> — Job seeker: sipho.mahlangu@example.co.za / Seeker123! · Employer: hr@brightwavetech.co.za / Employer123! · Admin: admin@careertrack.co.za / Admin123!</p>
    </div>
  </div>
</div>
