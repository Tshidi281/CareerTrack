<div class="page">
  <div class="container-narrow">
    <div class="card">
      <h1>Reset your password</h1>
      <%- include('../partials/flash') %>
      <% if (errors && errors.length) { %>
        <div class="alert alert-error"><ul style="margin:0; padding-left:18px;"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <% } %>
      <p class="muted">Enter the email address associated with your account. If it exists, we’ll create a reset request notification for it.</p>
      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send reset request</button>
      </form>
      <p style="text-align:center; margin-top:16px; font-size:.88rem;"><a href="/login">Back to login</a></p>
    </div>
  </div>
</div>
