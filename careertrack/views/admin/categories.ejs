<div class="page">
  <div class="container">
    <%- include('../partials/flash') %>
    <h1>Manage Job Categories</h1>
    <div class="dash-layout">
      <%- include('../partials/admin-side', { active: 'categories' }) %>

      <div class="stack">
        <div class="card">
          <h3>Add a New Category</h3>
          <form action="/admin/categories" method="POST" style="display:flex; gap:10px;">
            <input type="text" name="name" placeholder="e.g. Renewable Energy" required style="flex:1;">
            <button type="submit" class="btn btn-primary">Add Category</button>
          </form>
        </div>

        <div class="card" style="padding:0; overflow-x:auto;">
          <table class="data-table">
            <thead><tr><th>Category Name</th><th>Jobs in Category</th><th></th></tr></thead>
            <tbody>
              <% categories.forEach(c => { %>
                <tr>
                  <td><strong><%= c.name %></strong></td>
                  <td><%= c.job_count %></td>
                  <td>
                    <form action="/admin/categories/<%= c.id %>/delete" method="POST" data-confirm="Delete this category? Jobs in this category will become uncategorised.">
                      <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              <% if (categories.length === 0) { %>
                <tr><td colspan="3"><div class="empty-state"><div class="emoji">🗂️</div>No categories yet.</div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
