<% const currentUserSafe = typeof currentUser !== 'undefined' ? currentUser : null; const safeUserName = (currentUserSafe && currentUserSafe.full_name && String(currentUserSafe.full_name).trim()) || 'User'; const safeFirstName = safeUserName.split(/\s+/)[0] || 'User'; %>

<div class="page">
  <div class="container">
    <%- include('../partials/flash') %>
    <h1>Welcome back, <%= safeFirstName %> 👋</h1>

    <div class="dash-layout">
      <%- include('../partials/jobseeker-side', { active: 'dashboard' }) %>

      <div class="stack">
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
            <strong>Profile Completion</strong>
            <span style="font-weight:800; color:var(--teal-600);"><%= completion.score %>%</span>
          </div>
          <div class="progress-bar"><div style="width:<%= completion.score %>%;"></div></div>
          <% if (completion.score < 100) { %>
            <p style="font-size:.85rem; margin-top:10px; margin-bottom:0;">Complete your profile to improve your job match scores. <a href="/jobseeker/profile">Update profile →</a></p>
          <% } %>
        </div>

        <div class="grid-4">
          <div class="card stat-card">
            <div class="icon" style="background:var(--info-bg); color:var(--info);">📄</div>
            <div class="num"><%= totalApplications %></div>
            <div class="label">Total Applications</div>
          </div>
          <div class="card stat-card">
            <div class="icon" style="background:var(--purple-bg); color:var(--purple);">⭐</div>
            <div class="num"><%= statusCounts.find(s=>s.status==='Shortlisted')?.c || 0 %></div>
            <div class="label">Shortlisted</div>
          </div>
          <div class="card stat-card">
            <div class="icon" style="background:var(--success-bg); color:var(--success);">✅</div>
            <div class="num"><%= statusCounts.find(s=>s.status==='Accepted')?.c || 0 %></div>
            <div class="label">Accepted</div>
          </div>
          <div class="card stat-card">
            <div class="icon" style="background:var(--warning-bg); color:var(--warning);">⏳</div>
            <div class="num"><%= statusCounts.find(s=>s.status==='Pending')?.c || 0 %></div>
            <div class="label">Pending Review</div>
          </div>
        </div>

        <div class="card">
          <div class="section-title">
            <h2>Recommended For You</h2>
            <a href="/jobseeker/recommendations" class="btn btn-ghost">View all →</a>
          </div>
          <% if (recommendations.length === 0) { %>
            <div class="empty-state"><div class="emoji">🎯</div>No recommendations yet — add skills to your profile to get matched with jobs.<br><a href="/jobseeker/profile" class="btn btn-secondary btn-sm" style="margin-top:10px;">Add Skills</a></div>
          <% } else { %>
            <div class="grid-2">
              <% recommendations.forEach(r => { %>
                <%- include('../partials/job-card', { job: { ...r.job, company_name: r.job.company_name, skillNames: [] }, matchScore: r.score }) %>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="section-title"><h2>Recent Applications</h2><a href="/jobseeker/applications" class="btn btn-ghost">View all →</a></div>
            <% if (applications.length === 0) { %>
              <div class="empty-state"><div class="emoji">📭</div>No applications yet.</div>
            <% } else { %>
              <ul class="list-plain stack" style="gap:10px;">
                <% applications.forEach(a => { %>
                  <li style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--slate-100);">
                    <div>
                      <div style="font-weight:700; font-size:.9rem;"><%= a.title %></div>
                      <div style="font-size:.8rem; color:var(--slate-500);"><%= a.company_name %> · <%= a.applied_at.slice(0,10) %></div>
                    </div>
                    <span class="badge badge-<%= a.status %>"><%= a.status %></span>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>

          <div class="card">
            <div class="section-title"><h2>Notifications</h2><a href="/notifications" class="btn btn-ghost">View all →</a></div>
            <% if (notifications.length === 0) { %>
              <div class="empty-state"><div class="emoji">🔔</div>No notifications yet.</div>
            <% } else { %>
              <div class="stack" style="gap:6px;">
                <% notifications.forEach(n => { %>
                  <div class="notif-item <%= n.is_read ? '' : 'unread' %>">
                    <span class="notif-dot" style="visibility:<%= n.is_read ? 'hidden' : 'visible' %>;"></span>
                    <div>
                      <div style="font-weight:700; font-size:.87rem;"><%= n.title %></div>
                      <div style="font-size:.82rem; color:var(--slate-600);"><%= n.message %></div>
                      <div style="font-size:.72rem; color:var(--slate-400); margin-top:2px;"><%= n.created_at %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <h3>Quick Actions</h3>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="/jobs" class="btn btn-secondary">🔍 Search Jobs</a>
            <a href="/jobseeker/profile" class="btn btn-secondary">🧑 Complete Profile</a>
            <a href="/jobseeker/profile#documents" class="btn btn-secondary">📤 Upload CV</a>
            <a href="/jobseeker/applications" class="btn btn-secondary">📄 View Applications</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
